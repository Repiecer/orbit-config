// =============================================================================
// 星环配置器快捷键片段
// =============================================================================
// 把下面这段粘到 ~/.config/niri/__custom__.kdl 里（dunder 自定义文件，
// 系统升级不会被覆盖）。Mod+Ctrl+A 打开星环配置器。
//
// 说明：这里直接 spawn 启动器而不走 shell-action.sh，
// 因为 shell-action.sh 是系统文件，改它会在升级时丢失。
// =============================================================================

binds {
    // 打开星环配置器（Web 前端会自动在浏览器里打开）
    Mod+Ctrl+A repeat=false { spawn "sh" "-c" "exec python3 \"$HOME/Projects/orbit-config/orbit-config.py\""; }
}
